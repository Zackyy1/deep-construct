{
  "$id": "report-tests.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Test engineer report. Every acceptance criterion must be covered by at least one test.",
  "allOf": [
    { "$ref": "common.schema.json#/definitions/reportBase" },
    {
      "required": ["testFiles", "criteriaCovered", "command"],
      "properties": {
        "stage": { "const": "tests" },
        "testFiles": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "criteriaCovered": { "type": "array", "items": { "$ref": "common.schema.json#/definitions/acId" } },
        "command": { "type": "string", "minLength": 1 }
      }
    }
  ]
}
