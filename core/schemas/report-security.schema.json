{
  "$id": "report-security.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Security review report. Any critical/high finding fails the gate.",
  "allOf": [
    { "$ref": "common.schema.json#/definitions/reportBase" },
    {
      "required": ["findings", "checked"],
      "properties": {
        "stage": { "const": "security" },
        "findings": { "type": "array", "items": { "$ref": "common.schema.json#/definitions/finding" } },
        "checked": {
          "type": "array", "minItems": 1,
          "items": { "enum": ["auth", "authorization", "input-validation", "secrets", "dependencies", "injection", "xss", "csrf", "rate-limiting", "data-exposure", "infra"] }
        }
      }
    }
  ]
}
